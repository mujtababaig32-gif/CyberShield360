# Vercel production frontend should call your deployed backend API directly.
# Example: https://cybershield360-api.azurewebsites.net/api/v1
VITE_API_BASE=https://YOUR-BACKEND-API-DOMAIN/api/v1

# Google OAuth 2.0 Web Client ID — must include this production origin under
# Authorized JavaScript origins in Google Cloud Console, and must match the
# backend's GoogleAuth:ClientId for the same environment.
VITE_GOOGLE_CLIENT_ID=
