# Local development. Vite dev server proxies /api to http://localhost:8080.
VITE_API_BASE=/api/v1

# Google OAuth 2.0 Web Client ID (Google Cloud Console > APIs & Services > Credentials).
# Must have this exact origin (e.g. http://localhost:5173) under Authorized JavaScript
# origins, and must match the backend's GoogleAuth:ClientId. Leave blank to disable
# the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
